{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Bambu Status Plus",
  "Version": "1.1.0.0",
  "Author": "Dez",
  "Description": "Live status of your Bambu Lab printers over LAN. A progress border fills as the print runs. Press the key to flip between Status, AMS (each unit in turn) and Temperature pages, and choose what goes big in the middle of the Status page.",
  "Category": "Bambu Status Plus",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "UUID": "com.dez.bambustatus",
  "Actions": [
    {
      "Name": "Printer Status",
      "UUID": "com.dez.bambustatus.status",
      "Icon": "imgs/actions/status/icon",
      "Tooltip": "Print progress with a progress border. Press to cycle Status → AMS units → Temperatures.",
      "PropertyInspectorPath": "ui/printer.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/status.json",
        "TriggerDescription": {
          "Push": "Refresh",
          "Touch": "Refresh"
        }
      },
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/actions/status/key",
          "ShowTitle": true
        }
      ]
    }
  ]
}